{
  "name": "portifolio-webdev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.7",
    "@fontsource/barlow-condensed": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.15",
    "vite": "^7.1.12",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml,html}": "prettier --write"
  }
}
